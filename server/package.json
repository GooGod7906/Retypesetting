{
  "name": "pdf-typesetting-server",
  "version": "1.0.0",
  "description": "扫描件重排版后端服务",
  "private": true,
  "scripts": {
    "dev": "nodemon --verbose --watch src --ext ts,json --delay 2 --exec tsx src/server.ts",
    "mineru:lab": "tsx src/mineru-lab.ts",
    "layout:page": "tsx src/fixed-layout-preview.ts",
    "layout:word": "tsx src/fixed-layout-preview.ts",
    "test:word-layout": "npm run build && node --test test/word-layout.test.cjs",
    "build": "tsc",
    "start:typesetting": "node --max-old-space-size=256 dist/mineru-lab.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "htmlparser2": "^10.1.0",
    "katex": "^0.16.47",
    "mathjax-full": "^3.2.2",
    "mathml2omml": "^0.5.0",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.23.1",
    "sharp": "0.35.5",
    "stream-json": "^1.9.1",
    "unzipper": "^0.12.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/stream-json": "^1.7.8",
    "@types/unzipper": "^0.10.10",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0"
  }
}
