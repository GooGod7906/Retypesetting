# Server Configuration
PORT=3000
NODE_ENV=development

# MinerU API Configuration
MINERU_API_TOKEN=
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_LAB_PORT=4174
# MINERU_LAB_HOST=0.0.0.0
# MINERU_LAB_ALLOWED_HOSTS=typesetting.example.com,192.168.1.10
DATABASE_URL=
# 0 表示保留至手动清除，1–60 表示新任务的有效分钟数。
TYPESETTING_RETENTION_MINUTES=30
# TYPESETTING_DATA_DIR=./outputs/mineru-lab

# File Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
TEMPLATE_DIR=./templates
MAX_FILE_SIZE=209715200

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
